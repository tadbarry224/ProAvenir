# Modèle de configuration du backend ProAvenir.
# Copier ce fichier en `.env` (jamais versionné) puis remplacer les valeurs `change-me`.

# --- Application ------------------------------------------------------------
NODE_ENV=development
# Port de l'API (3000 est souvent occupé ; l'API répond sur http://localhost:3001/api)
PORT=3001
# Adresse(s) du frontend autorisée(s) à appeler l'API, séparées par des virgules
CORS_ORIGIN=http://localhost:8443,http://localhost:5173

# --- PostgreSQL (lu par docker-compose.yml) --------------------------------
POSTGRES_USER=proavenir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proavenir
# Port publié sur la machine (5432/5433 peuvent être utilisés par d'autres projets)
POSTGRES_PORT=5434

# --- Prisma ------------------------------------------------------------------
# Doit reprendre les valeurs ci-dessus. 127.0.0.1 plutôt que localhost évite
# une tentative de connexion en IPv6 (::1) sous Windows.
DATABASE_URL=postgresql://proavenir:change-me@127.0.0.1:5434/proavenir?schema=public

# --- Authentification ---------------------------------------------------------
# Secret de signature des jetons d'accès (JWT) : 32 caractères minimum, aléatoire.
# Le générer avec :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# « change-me » est refusé au démarrage ; une valeur de démonstration est refusée en production.
JWT_ACCESS_SECRET=change-me
# Durée de vie d'un jeton d'accès (entre 1m et 1h)
ACCESS_TOKEN_TTL=15m
# Durée maximale d'une session « Se souvenir de moi », en jours (1 à 90).
# Sans « Se souvenir de moi », la session dure 24 heures au maximum.
REFRESH_TOKEN_TTL_DAYS=30

# --- Fichiers -----------------------------------------------------------------
# Dossier des CV déposés par les candidats (PDF). Relatif au dossier backend/,
# jamais versionné (voir .gitignore). Facultatif : « storage/cvs » par défaut.
CV_STORAGE_DIR=storage/cvs
